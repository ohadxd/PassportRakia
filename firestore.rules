rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function ownsSession(sessionId) {
      return signedIn()
        && exists(sessionPath(sessionId))
        && get(sessionPath(sessionId)).data.ownerUid == request.auth.uid;
    }

    function createsOwnSession(sessionId) {
      return signedIn()
        && request.resource.data.id == sessionId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60;
    }

    match /sessions/{sessionId} {
      allow create: if createsOwnSession(sessionId);
      allow read: if ownsSession(sessionId);
      allow update: if ownsSession(sessionId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == resource.data.id;
      allow delete: if false;

      match /missionProgress/{missionId} {
        allow read: if ownsSession(sessionId);
        allow create, update: if ownsSession(sessionId)
          && request.resource.data.missionId == missionId
          && request.resource.data.order is int
          && request.resource.data.status in ['not-started', 'started', 'completed', 'skipped']
          && request.resource.data.score is number
          && request.resource.data.score >= 0;
        allow delete: if false;
      }
    }

    match /dreams/{dreamId} {
      allow read: if resource.data.approved == true;
      allow create: if signedIn()
        && request.resource.data.sessionId is string
        && ownsSession(request.resource.data.sessionId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.dream is string
        && request.resource.data.dream.size() >= 1
        && request.resource.data.dream.size() <= 120
        && request.resource.data.approved is bool
        && request.resource.data.scoreAtSubmit is number;
      allow update, delete: if false;
    }

    match /creations/{creationId} {
      allow read: if signedIn() && ownsSession(resource.data.sessionId);
      allow create, update: if signedIn()
        && request.resource.data.sessionId is string
        && ownsSession(request.resource.data.sessionId)
        && request.resource.data.type in ['patch', 'jewelry']
        && request.resource.data.imageUrl is string
        && request.resource.data.storagePath is string;
      allow delete: if false;
    }

    match /pdfExports/{sessionId} {
      allow read: if ownsSession(sessionId);
      allow create, update: if ownsSession(sessionId)
        && request.resource.data.sessionId == sessionId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
